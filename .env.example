# Gate.io API v4 credentials (create at gate.io → API Management).
# The web app can also set these for you: start the server and open the setup card.
GATE_API_KEY=
GATE_API_SECRET=

# Optional overrides:
# PORT=6688                                # server port (default 6688)
# ARB_DATA_DIR=/absolute/path/to/data      # trade journal location (default: <repo>/data)
# DOTENV_CONFIG_PATH=/absolute/path/.env   # where credentials are read from and saved to (default: <repo>/.env)
# BOROS_TAKER_FEE_OVERRIDE=0.0001          # force this Boros taker-fee rate (fraction) in the opportunities scan
